# ==============================================================================
# Ecommerce MVP — Unified Development Environment Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / Infrastructure Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 2. Storefront (Next.js - Port 3000)
# ------------------------------------------------------------------------------
# Public URLs & Client Keys
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_test_placeholder

# Server-only Storefront Secrets & Database Connection
# DATABASE_URL is required by Storefront for direct MedusaCustomerService queries
DATABASE_URL=postgres://postgres:postgres_secure_password@localhost:5432/medusa_db
MEDUSA_PUBLISHABLE_KEY=pk_test_placeholder
STRAPI_API_TOKEN=strapi_read_token_placeholder

# Storefront Payment & Razorpay Verification Secrets
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Storefront Authentication & DevFetch OTP Secrets
# S2S_AUTH_TOKEN authorizes internal API and devfetch OTP retrieval
OTP_SECRET=dev_secret_otp_key_minimum_32_characters
S2S_AUTH_TOKEN=ecom-s2s-dev-token-secret

# SMS / OTP Provider Configuration (Storefront BFF handles SMS dispatch)
# Options: mock | fast2sms | twilio
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 3. Medusa Commerce Backend (Port 9000)
# ------------------------------------------------------------------------------
PORT=9000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:3000

# Security Tokens
JWT_SECRET=super_secret_jwt_key_minimum_32_characters
COOKIE_SECRET=super_secret_cookie_key_minimum_32_characters

# ------------------------------------------------------------------------------
# 4. Strapi CMS (Port 1337)
# ------------------------------------------------------------------------------
STRAPI_PORT=1337
STRAPI_DATABASE_URL=postgres://postgres:postgres_secure_password@localhost:5432/strapi_db
HOST=0.0.0.0
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=strapi_api_token_salt_placeholder
ADMIN_JWT_SECRET=strapi_admin_jwt_secret_placeholder
TRANSFER_TOKEN_SALT=strapi_transfer_token_salt_placeholder
DATABASE_CLIENT=postgres
CORS_ORIGIN=http://localhost:3000,http://localhost:1337
