{
  "name": "ecom-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "India-First Fashion Ecommerce MVP Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.dev.yml logs -f",
    "infra:status": "docker compose -f infrastructure/docker/docker-compose.dev.yml ps",
    "infra:verify": "node infrastructure/scripts/verify-infra.mjs",
    "dev:storefront": "npm run dev --workspace=apps/storefront",
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:cms": "npm run dev --workspace=apps/cms",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
